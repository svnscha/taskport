{
  "name": "echo",
  "version": "1",
  "description": "Return a message and produce a text artifact. Requires only Python.",
  "command": ["{python}", "echo.py"],
  "inputs": {
    "type": "object",
    "properties": {
      "message": {"type": "string", "description": "Message to echo"}
    },
    "required": ["message"],
    "additionalProperties": false
  },
  "timeout_seconds": 30
}
